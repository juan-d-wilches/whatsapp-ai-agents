    {
      "parameters": {
        "jsCode": "// Obtenemos el valor retornado por el nodo Redis (Get user_seen)\nconst userSeen = $json.userSeen || $json.value;\n\n// Si user_seen no existe (null o undefined), es un usuario nuevo\n// Si user_seen existe, significa que ya nos había hablado hoy pero su memoria de 30 min expiró\nconst estado_usuario = (!userSeen) ? \"NUEVO\" : \"EXPIRADO\";\n\nreturn [{\n  json: {\n    ...$('Extract Data').item.json,\n    estado_usuario: estado_usuario\n  }\n}];"
      },
