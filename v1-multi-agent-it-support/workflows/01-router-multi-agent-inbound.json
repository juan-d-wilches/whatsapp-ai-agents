      "parameters": {
        "jsCode": "const rawOutput = ($json.text || '').toLowerCase().trim();\nlet detectedIntent = 'menu';\n\nif (rawOutput.includes('soporte') || rawOutput === '1') {\n  detectedIntent = 'soporte';\n} else if (rawOutput.includes('ventas') || rawOutput === '2') {\n  detectedIntent = 'ventas';\n}\n\nreturn [{\n  json: {\n    ...$('Extract Data').item.json,\n    session_mode: detectedIntent\n  }\n}];"
